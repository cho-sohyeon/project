<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.exerciselog.mapper.ExerciseLogMapper">

    <select id="findAll" resultType="com.example.exerciselog.domain.ExerciseLog">
        SELECT
            id,
            exercise_name,
            exercise_date,
            duration_minutes,
            created_at
        FROM exercise_log
        ORDER BY exercise_date DESC, id DESC
    </select>

</mapper>
